# OS / editor
.DS_Store
*.swp
*.log
.idea/
*.iml
.vscode/

# Flutter / Dart (any depth: the app lives under flutter-ui/)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/android/app/debug
**/android/app/profile
**/android/app/release
app.*.symbols
app.*.map.json
.env

# Generated per-environment Flutter config (make ui-config)
flutter-ui/config/*.json

# Go
bin/
coverage.out

# Helm
dist/
*.tgz

# Terraform / Terragrunt
**/.terraform/
**/.terragrunt-cache/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
terraform.tfvars
terraform.tfvars.json

# Local kubeconfigs. The deploy credential is written to $RUNNER_TEMP or
# $TMPDIR, never here, but a hand-passed path could land in the tree.
.kube/
*.kubeconfig

# Editor-local MCP config
.cursor/

# Claude Code. Only the permission policy is tracked, so it reaches a fresh
# clone and a cloud session; neither sees a machine-local settings file.
.claude/*
!.claude/settings.json

# Generated per-project web config (make ui-config). The pool is per
# platform project, so a committed copy is right for exactly one of them.
flutter-ui/web/config.json
